{
  "$defs": {
    "ruleId": {
      "description": "A rule ID of the catalog, as `crawlforge rules` lists it. CrawlForge also accepts it in lower case; the schema lists the canonical spelling.",
      "enum": [
        "INDEX-NOINDEX",
        "INDEX-NOFOLLOW-INTERNAL",
        "HTTP-5XX",
        "HTTP-MIXED-CONTENT",
        "HTTP-SLOW-RESPONSE",
        "HTTP-LARGE-PAGE",
        "META-TITLE-MISSING",
        "META-TITLE-TOO-LONG",
        "META-TITLE-TOO-SHORT",
        "META-TITLE-MULTIPLE",
        "META-DESC-MISSING",
        "META-DESC-TOO-LONG",
        "META-DESC-TOO-SHORT",
        "META-VIEWPORT-MISSING",
        "META-REFRESH",
        "META-OUTSIDE-HEAD",
        "CANON-MISSING",
        "CANON-MULTIPLE",
        "CANON-RELATIVE",
        "CANON-CROSS-DOMAIN",
        "CONTENT-H1-MISSING",
        "CONTENT-H1-MULTIPLE",
        "CONTENT-H1-EMPTY",
        "CONTENT-HEADING-SKIP",
        "CONTENT-THIN",
        "CONTENT-LANG-MISSING",
        "ASSET-IMG-NO-ALT",
        "ASSET-IMG-EMPTY-ALT-LINK",
        "HREFLANG-NO-SELF",
        "HREFLANG-INVALID-CODE",
        "HREFLANG-LANG-MISMATCH",
        "HREFLANG-SELF-ONLY",
        "SOCIAL-OG-MISSING",
        "LINK-ANCHOR-EMPTY",
        "LINK-ANCHOR-GENERIC",
        "INDEX-DEEP-PAGE",
        "INDEX-SECTION-DISCONNECTED",
        "INDEX-NO-INTERNAL-LINKS-IN",
        "INDEX-BLOCKED-IN-SITEMAP",
        "INDEX-NOINDEX-IN-SITEMAP",
        "INDEX-SITEMAP-MISSING",
        "INDEX-ORPHAN-PAGE",
        "INDEX-ROBOTS-TXT-MISSING",
        "INDEX-ROBOTS-TXT-BLOCKS-ALL",
        "INDEX-SITEMAP-ERROR",
        "INDEX-ROBOTS-BLOCKED",
        "HTTP-404-INTERNAL",
        "HTTP-404-EXTERNAL",
        "HTTP-EXTERNAL-UNVERIFIABLE",
        "HTTP-REDIRECT-CHAIN",
        "HTTP-REDIRECT-LOOP",
        "HTTP-REDIRECT-TO-404",
        "HTTP-NO-HTTPS",
        "META-TITLE-DUPLICATE",
        "META-DESC-DUPLICATE",
        "CANON-TO-4XX",
        "CANON-TO-NOINDEX",
        "CANON-CHAIN",
        "CANON-TO-REDIRECT",
        "DUP-CONTENT-EXACT",
        "DUP-CONTENT-NEAR",
        "ASSET-IMG-BROKEN",
        "ASSET-IMG-HEAVY",
        "ASSET-BROKEN",
        "ASSET-JS-HEAVY",
        "ASSET-CSS-HEAVY",
        "ASSET-IFRAME-BROKEN",
        "ASSET-FORM-BROKEN",
        "HREFLANG-NOT-RECIPROCAL",
        "HREFLANG-TO-4XX",
        "SOCIAL-OG-IMAGE-BROKEN"
      ]
    },
    "severity": {
      "description": "A severity, from most to least serious.",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    }
  },
  "$id": "https://raw.githubusercontent.com/dcarrero/crawlforge/main/docs/crawl-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Settings for `crawlforge crawl|audit|list --config <file>`. The file describes the site; the command line describes the run, and command-line flags override the file. Every key is optional: an absent key keeps its default. An unknown key is an error, not an option silently ignored. `report`, `inspect`, `export`, `diff` and `portfolio` accept the same file and use only its `rules:` block. Generated by `crawlforge config schema`.",
  "properties": {
    "check_external": {
      "default": true,
      "description": "Check the status of linked external URLs: one HEAD request per distinct URL, nothing of the other site crawled. It is what detects broken external links. Flag: --no-external-check turns it off.",
      "type": "boolean"
    },
    "collect_body_text": {
      "default": false,
      "description": "Store the body text for full-text search (FTS5). Pro tier; it multiplies the size of the crawl file.",
      "type": "boolean"
    },
    "concurrency": {
      "default": 5,
      "description": "Concurrent requests per host, from 1 to 20. Flag: --concurrency.",
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
    },
    "discover_sitemaps": {
      "default": true,
      "description": "Discover and read sitemaps. Crossing the sitemap with the links finds orphan pages. Flag: --no-sitemaps turns it off.",
      "type": "boolean"
    },
    "exclude_patterns": {
      "default": [],
      "description": "Do not crawl the URLs that match one of these regular expressions (unanchored). They win over include_patterns, and what they exclude is recorded in the report, not hidden. Flag: --exclude, which replaces this list instead of adding to it.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "follow_external": {
      "default": false,
      "description": "Crawl the linked external URLs too, instead of only checking their status. No command-line flag, and a resumed crawl ignores it. Still subject to the network perimeter: it cannot reach addresses of your own network.",
      "type": "boolean"
    },
    "ignore_robots": {
      "default": false,
      "description": "Ignore robots.txt. Only on sites you own. A resumed crawl never inherits it: permission is granted by whoever runs the command, not by a file. Flag: --ignore-robots.",
      "type": "boolean"
    },
    "include_patterns": {
      "default": [],
      "description": "Crawl only the URLs that match one of these regular expressions (unanchored: a literal string works as \"contains\"). The seed is always crawled. Flag: --include, which replaces this list instead of adding to it.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "max_depth": {
      "description": "Maximum depth, in clicks from the seed. Unlimited by default. Flag: --max-depth.",
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "max_duration_secs": {
      "description": "Maximum duration of the crawl, in seconds. Unlimited by default.",
      "minimum": 0,
      "type": "integer"
    },
    "max_external": {
      "default": 10000,
      "description": "Maximum external URLs checked per crawl. Past it, the summary says how many were left unchecked. Flag: --max-external.",
      "minimum": 0,
      "type": "integer"
    },
    "max_external_urls": {
      "default": 100000,
      "description": "Maximum external URLs recorded per crawl (`max_external` caps the ones checked; this caps the ones that get a row at all). Past it, the summary says how many were left out. It does not mark the crawl as truncated.",
      "minimum": 0,
      "type": "integer"
    },
    "max_urls": {
      "description": "Stop after this many URLs of the audited site. Without it, the crawl runs until the site is exhausted, or until the tier's cap (the free tier stops at 1,000). External URLs do not count. Flag: --max-urls.",
      "minimum": 0,
      "type": "integer"
    },
    "project_name": {
      "description": "Project name, stored in the crawl file. Defaults to the seed URL (or the folder, for `audit`).",
      "type": "string"
    },
    "respect_nofollow": {
      "default": true,
      "description": "Honour rel=\"nofollow\" when discovering links.",
      "type": "boolean"
    },
    "rules": {
      "additionalProperties": false,
      "description": "Per-site rule configuration: rules this site does not want to hear about, and severities that weigh differently for it. Applied when the crawl file is read, never when it is written: the crawl evaluates every rule and stores every finding, and this block travels inside the crawl file. `report <file> --config <yaml>` replaces the stored block without crawling again. List the rule IDs with `crawlforge rules`.",
      "properties": {
        "disable": {
          "description": "Rule IDs whose findings are not reported. A rule cannot be both here and in `severity`.",
          "items": {
            "$ref": "#/$defs/ruleId"
          },
          "type": "array"
        },
        "severity": {
          "additionalProperties": false,
          "description": "Rule ID → the severity its findings are reported with. `diff --fail-on` judges this severity.",
          "properties": {
            "ASSET-BROKEN": {
              "$ref": "#/$defs/severity"
            },
            "ASSET-CSS-HEAVY": {
              "$ref": "#/$defs/severity"
            },
            "ASSET-FORM-BROKEN": {
              "$ref": "#/$defs/severity"
            },
            "ASSET-IFRAME-BROKEN": {
              "$ref": "#/$defs/severity"
            },
            "ASSET-IMG-BROKEN": {
              "$ref": "#/$defs/severity"
            },
